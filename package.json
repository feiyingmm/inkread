    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-front-matter": "^0.2.4",
    "mermaid": "^11.9.0",
    "pinia": "^3.0.3",
    "vditor": "^3.11.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
